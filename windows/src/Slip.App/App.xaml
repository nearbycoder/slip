<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Slip.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Slip brand green (#16a34a) as the accent colour for every control. -->
            <Color x:Key="SystemAccentColor">#FF16A34A</Color>
            <Color x:Key="SystemAccentColorLight1">#FF22C55E</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4ADE80</Color>
            <Color x:Key="SystemAccentColorLight3">#FF86EFAC</Color>
            <Color x:Key="SystemAccentColorDark1">#FF15803D</Color>
            <Color x:Key="SystemAccentColorDark2">#FF166534</Color>
            <Color x:Key="SystemAccentColorDark3">#FF14532D</Color>
            <SolidColorBrush x:Key="SlipBrandBrush" Color="#FF16A34A" />

            <Style x:Key="SlipCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
