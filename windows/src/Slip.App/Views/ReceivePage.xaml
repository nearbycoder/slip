<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Slip.App.Views.ReceivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="900">
            <TextBlock Text="Receive" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- "Ready to receive" card -->
            <Border Style="{StaticResource SlipCardStyle}" Padding="32">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Slip-256.png" Width="96" Height="96" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind State.ReceiveHeadline, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind State.Alias, Mode=OneWay}"
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        Foreground="{StaticResource SlipBrandBrush}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind State.AddressesText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <TextBlock
                        Text="{x:Bind State.PortText, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <ToggleSwitch
                            Header="Discoverable"
                            OnContent="Visible to nearby devices"
                            OffContent="Hidden"
                            IsOn="{x:Bind State.IsDiscoverable, Mode=TwoWay}" />
                        <ToggleSwitch
                            Header="Quick Save"
                            OnContent="Accept automatically"
                            OffContent="Ask every time"
                            IsOn="{x:Bind State.QuickSave, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Current incoming transfer -->
            <Border Style="{StaticResource SlipCardStyle}" Visibility="{x:Bind State.HasActiveReceive, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind State.ActiveReceive.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar Value="{x:Bind State.ActiveReceive.Progress, Mode=OneWay, FallbackValue=0}" Maximum="100" />
                    <TextBlock
                        Text="{x:Bind State.ActiveReceive.StatusText, Mode=OneWay, FallbackValue=''}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="View in Transfers" Click="OnViewTransfers" Padding="0" />
                </StackPanel>
            </Border>

            <TextBlock
                Text="Other devices running Slip or LocalSend on the same network can now send files to this PC."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
