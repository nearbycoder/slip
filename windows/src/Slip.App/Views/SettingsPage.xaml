<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Slip.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="6" MaxWidth="900">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Device name" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="How this PC appears to nearby devices." Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="260" Text="{x:Bind ViewModel.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Follow Windows, or always use light or dark." Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="160" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <x:String>Use system setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Receiving -->
            <TextBlock Text="Receiving" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Save folder" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SaveDirectory, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Change…" Click="OnPickSaveFolder" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Quick Save" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Accept incoming files automatically without asking." Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoAccept, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Require PIN" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Senders must enter this PIN before they can send to you." Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.RequirePin, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                    <PasswordBox
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        MaxWidth="260"
                        HorizontalAlignment="Left"
                        PlaceholderText="PIN"
                        PasswordRevealMode="Peek"
                        Password="{x:Bind ViewModel.Pin, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.RequirePin, Mode=OneWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Discoverable" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Announce this PC to nearby devices and answer their announcements." Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Discoverable, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
            </Border>

            <!-- Network -->
            <TextBlock Text="Network" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Port" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="TCP port for receiving (default 53317, the LocalSend port)." Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <NumberBox
                        Grid.Column="1"
                        Width="160"
                        Minimum="1"
                        Maximum="65535"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SlipCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Encryption (HTTPS)" Style="{StaticResource SettingTitleStyle}" />
                        <TextBlock Text="Recommended. Turn off only to talk to devices that have encryption disabled." Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.UseHttps, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                </Grid>
            </Border>
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Windows Firewall"
                Message="When Windows asks, allow Slip on private networks. Otherwise other devices cannot find this PC or send to it (TCP and UDP on the port above)." />

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SlipCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SettingTitleStyle}">
                        <Run Text="Slip " /><Run Text="{x:Bind ViewModel.Version}" />
                    </TextBlock>
                    <TextBlock Text="Compatible with LocalSend (protocol v2)." Style="{StaticResource SettingDescriptionStyle}" />
                    <TextBlock Style="{StaticResource SettingDescriptionStyle}" IsTextSelectionEnabled="True">
                        <Run Text="Fingerprint: " /><Run Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingDescriptionStyle}" IsTextSelectionEnabled="True">
                        <Run Text="Data folder: " /><Run Text="{x:Bind ViewModel.DataDirectory}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
