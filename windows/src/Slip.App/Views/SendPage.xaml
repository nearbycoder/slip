<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Slip.App.Views.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Slip.App.ViewModels"
    xmlns:h="using:Slip.App.Helpers"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="OnPageDragOver"
    Drop="OnPageDrop">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Send" Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Selection tray -->
        <Border Grid.Row="1" Style="{StaticResource SlipCardStyle}">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnPickFiles">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="Files" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPickFolder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Folder" />
                            <TextBlock Text="Folder" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnAddText">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Message" />
                            <TextBlock Text="Text" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPaste">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Paste" />
                            <TextBlock Text="Paste" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind State.ClearSelectionCommand}" Visibility="{x:Bind State.HasSelection, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Clear" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock
                    Text="{x:Bind State.SelectionSummary, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{x:Bind State.Selection}" Visibility="{x:Bind State.HasSelection, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="250" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectionItemViewModel">
                            <Grid
                                Margin="0,0,8,8"
                                Padding="10,6"
                                ColumnSpacing="10"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Detail}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Padding="6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Remove"
                                    Click="OnRemoveSelection">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Nearby devices header -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nearby devices" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind State.IsScanning, Mode=OneWay}" />
            <Button Grid.Column="2" Command="{x:Bind State.RefreshCommand}" ToolTipService.ToolTip="Announce and scan the local network">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Device cards: click to send the selection, or drop files onto a card. -->
        <GridView
            x:Name="PeerGrid"
            Grid.Row="3"
            ItemsSource="{x:Bind State.Peers}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnPeerClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:PeerViewModel">
                    <Border
                        Width="260"
                        Height="92"
                        Style="{StaticResource SlipCardStyle}"
                        Padding="14,12"
                        AllowDrop="True"
                        DragOver="OnPeerDragOver"
                        Drop="OnPeerDrop">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="30" Foreground="{StaticResource SlipBrandBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Alias, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Model, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind AddressText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind IsSending, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel
            Grid.Row="3"
            Spacing="8"
            Padding="0,32"
            HorizontalAlignment="Center"
            Visibility="{x:Bind h:Format.CollapsedIf(State.HasPeers), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="32" Height="32" />
            <TextBlock Text="Looking for nearby devices…" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                MaxWidth="460"
                Text="Open Slip or LocalSend on the other device and make sure both are on the same Wi-Fi or network. If nothing shows up, press Refresh or enter an IP address below."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextAlignment="Center" />
        </StackPanel>

        <!-- Manual address -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <TextBox
                x:Name="ManualAddress"
                Width="320"
                PlaceholderText="Add by IP, e.g. 192.168.1.20:53317"
                KeyDown="OnManualAddressKeyDown" />
            <Button Content="Add device" Click="OnManualConnect" />
        </StackPanel>
    </Grid>
</Page>
