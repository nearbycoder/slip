<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Slip.App.Views.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Slip.App.ViewModels"
    xmlns:h="using:Slip.App.Helpers"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Transfers" Style="{StaticResource TitleTextBlockStyle}" />
            <Button HorizontalAlignment="Right" Command="{x:Bind State.ClearFinishedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="Clear finished" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="0,32"
            HorizontalAlignment="Center"
            Text="No transfers yet. Files you send or receive will appear here."
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind h:Format.CollapsedIf(State.HasTransfers), Mode=OneWay}" />

        <ListView Grid.Row="1" ItemsSource="{x:Bind State.Transfers}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferViewModel">
                    <Border Style="{StaticResource SlipCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{StaticResource SlipBrandBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button
                                        Command="{x:Bind OpenFolderCommand}"
                                        Visibility="{x:Bind CanOpenFolder}"
                                        ToolTipService.ToolTip="Open folder">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Command="{x:Bind CancelCommand}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}"
                                        ToolTipService.ToolTip="Cancel">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ProgressBar
                                Value="{x:Bind Progress, Mode=OneWay}"
                                Maximum="100"
                                IsIndeterminate="{x:Bind IsWaiting, Mode=OneWay}"
                                ShowError="{x:Bind HasError, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />

                            <ItemsControl ItemsSource="{x:Bind Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TransferFileViewModel">
                                        <Grid Padding="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                                <Button
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{x:Bind OpenCommand}"
                                                    Visibility="{x:Bind CanOpen, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Open">
                                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                                </Button>
                                                <Button
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{x:Bind RevealCommand}"
                                                    Visibility="{x:Bind CanOpen, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Show in Explorer">
                                                    <FontIcon Glyph="&#xEC50;" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
